{
  "name": "inventario-front",
  "version": "0.0.16",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-and-package.mjs",
    "build:prod": "ng build --configuration production",
    "build:major": "node scripts/build-and-package.mjs M",
    "build:minor": "node scripts/build-and-package.mjs m",
    "build:patch": "node scripts/build-and-package.mjs",
    "build:dev": "ng build --configuration development",
    "typecheck": "ng build --configuration development --no-progress",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@stomp/stompjs": "^7.3.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.15",
    "@angular/cli": "^20.3.15",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs-client": "^1.5.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
